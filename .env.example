# my-warehouse local development (.env at repo root for docker compose).
#
# Copy to .env and adjust secrets. Dev-friendly defaults below; use
# `openssl rand -hex 32` for production-like secrets.
# See deploy/k8s/ (ConfigMap + Secret layout) for the Kubernetes layout.

# --- Database (compose postgres service) ---

DATABASE_PASSWORD=change-me-db-password

# --- Auth / encryption (required) ---

JWT_SECRET=dev-only-change-me-with-openssl-rand-hex-32
SECRET_ENCRYPTION_KEY=dev-only-change-me-32-chars-minimum

# --- HTTP / CORS ---

CORS_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200

# When true, refresh cookie requires HTTPS. Keep false for local ng serve / compose.
AUTH_COOKIE_SECURE=false
